{
  "name": "whittle-guide",
  "version": "0.1.0",
  "description": "Turn museum 3D models into practical wood-carving guides, entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "catalogue": "node scripts/build-catalogue.mjs",
    "smoke": "node scripts/smoke.mjs",
    "wasm:build": "bash wasm/build.sh"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.185.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
